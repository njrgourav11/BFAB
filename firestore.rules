rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the user has the 'admin' role in their user profile
    // OR if they are the hardcoded super-admin email (Bootstrap fail-safe)
    function isAdmin() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        request.auth.token.email == 'njrgourav@gmail.com'
      );
    }

    // Check if the user is accessing their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // --- Collection Rules ---

    // Users Collection
    match /users/{userId} {
      // Users can read their own profile, Admins can read all
      allow read: if isOwner(userId) || isAdmin();
      
      // Users can create their own profile on sign-up
      allow create: if isOwner(userId);
      
      // Users can update their own profile (displayName, etc.)
      // BUT they cannot change their 'role' field unless they are an Admin
      allow update: if (isOwner(userId) && 
                        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
                       ) || isAdmin();
    }

    // Products Collection
    match /products/{productId} {
      allow read: if true; // Publicly readable for the shop
      allow write: if isAdmin(); // Only admins can add/edit/delete
    }

    // Blogs Collection
    match /blogs/{blogId} {
      allow read: if true; // Publicly readable
      allow write: if isAdmin(); // Only admins can manage blogs
    }

    // Orders Collection
    match /orders/{orderId} {
      // Authenticated users can create orders
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // Users can read their own orders, Admins can read all
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      
      // Only admins can update or delete orders
      allow update, delete: if isAdmin();
    }
  }
}
